# Optional environment configuration. The app does not load .env automatically.
# Set these as OS/shell environment variables before starting Velvet.
# No service credentials are required or supported by this release.

# Alternate local library/settings directory (optional):
# VELVET_USER_DATA=C:\VelvetData

# MusicBrainz User-Agent contact. Use your real public maintainer URL or email
# if distributing your own fork. Default contact is the public maintainer profile.
# VELVET_CATALOG_CONTACT=https://github.com/TheBabyKingdom

